# Go-Bite — environment template. Names only, never commit real values.
# Copy to .env.local for local development. Production values live outside the
# repo (e.g. /etc/gobite/prod.env, mode 600).

# ---- runtime ----------------------------------------------------------------
NODE_ENV=development
# Public origin of the deployment. Used for absolute links + cross-origin checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- persistence ------------------------------------------------------------
# Without these the app boots in demo mode: everything is in memory and is lost
# on restart. GET /api/health/ready fails when these are missing in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- sessions / crypto ------------------------------------------------------
# Signs OTP + session-token hashes. Rotating it logs everyone out (by design).
# Generate: openssl rand -hex 32
SESSION_SECRET=

# ---- SMS (Fast2SMS, DLT-registered) ----------------------------------------
# In production all three are required: Fast2SMS rejects sends without a
# DLT-approved sender + template id, and OTP requests fail loudly without them.
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_OTP_TEMPLATE_ID=
# Platform-wide daily SMS ceiling circuit-breaker (anti-wallet exhaustion)
MAX_DAILY_SMS=1000

# ---- payments (reserved — no gateway code ships in this release) ------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- cron -------------------------------------------------------------------
# Protects POST /api/v1/cron/expire-orders (auto-cancels unaccepted orders).
# Generate: openssl rand -hex 32
CRON_SECRET=
